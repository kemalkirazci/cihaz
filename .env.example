# ================================================
# REJISTA - Otonom Video Üretim Ekosistemi
# Ortam Değişkenleri Şablonu
# ================================================

# Google Cloud Platform
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
GOOGLE_CLOUD_REGION=us-central1

# Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro

# Vertex AI
VERTEX_AI_LOCATION=us-central1
VEO_MODEL_ENDPOINT=your-veo-endpoint

# Google Workspace
GOOGLE_SHEETS_ID=your-spreadsheet-id
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id
GMAIL_USER_EMAIL=your-email@gmail.com

# Etsy API (Opsiyonel - webhook yerine polling için)
ETSY_API_KEY=your-etsy-api-key
ETSY_SHOP_ID=your-shop-id

# Sistem Ayarları
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Maliyet Limitleri (USD)
MAX_COST_PER_ORDER=5.00
DAILY_BUDGET_LIMIT=100.00
MONTHLY_BUDGET_LIMIT=2000.00

# Video Üretim Ayarları
VIDEO_DURATION_SECONDS=60
VIDEO_RESOLUTION=1080p
MAX_CONCURRENT_PRODUCTIONS=3
PRODUCTION_TIMEOUT_MS=300000

# Retry Ayarları
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=2000

# Dashboard
DASHBOARD_PORT=8080
DASHBOARD_SECRET=your-dashboard-secret
